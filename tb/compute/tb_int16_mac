
`timescale 1ns/1ps

module tb_int16_mac;

    logic clk;
    logic rst_n;
    logic clear_acc;
    logic valid_in;

    logic signed [15:0] a;
    logic signed [15:0] b;
    logic signed [34:0] acc_in;

    logic signed [34:0] acc_out;
    logic valid_out;

    logic signed [63:0] expected;

    integer tests_passed;
    integer tests_failed;

    // DUT
    int16_mac dut (
        .clk       (clk),
        .rst_n     (rst_n),
        .clear_acc (clear_acc),
        .valid_in  (valid_in),
        .a         (a),
        .b         (b),
        .acc_in    (acc_in),
        .acc_out   (acc_out),
        .valid_out (valid_out)
    );

    // Clock: 10 ns
    initial clk = 1'b0;
    always #5 clk = ~clk;

    // Compare DUT against 64-bit reference.
    task automatic check_result(input string test_name);
        begin
            if (acc_out !== expected[34:0]) begin
                $display("[FAIL] %s", test_name);
                $display("  Expected: %0d", expected);
                $display("  Actual:   %0d", $signed(acc_out));
                tests_failed = tests_failed + 1;
            end
            else begin
                $display("[PASS] %s | result=%0d",
                         test_name, $signed(acc_out));
                tests_passed = tests_passed + 1;
            end
        end
    endtask

    // Apply one MAC operation.
    task automatic apply_mac(
        input logic signed [15:0] aa,
        input logic signed [15:0] bb,
        input string test_name
    );
        begin
            @(negedge clk);

            a         = aa;
            b         = bb;
            acc_in    = acc_out;
            valid_in  = 1'b1;
            clear_acc = 1'b0;

            expected = expected
                     + (longint'(aa) * longint'(bb));

            @(posedge clk);
            #1;

            if (valid_out !== 1'b1) begin
                $display("[FAIL] %s: valid_out no activo",
                         test_name);
                tests_failed = tests_failed + 1;
            end
            else begin
                check_result(test_name);
            end
        end
    endtask

    // Clear accumulator.
    task automatic clear_accumulator;
        begin
            @(negedge clk);

            valid_in  = 1'b0;
            clear_acc = 1'b1;

            @(posedge clk);
            #1;

            expected = 64'sd0;

            if (acc_out !== 35'sd0 || valid_out !== 1'b0) begin
                $display("[FAIL] CLEAR_ACC");
                tests_failed = tests_failed + 1;
            end
            else begin
                $display("[PASS] CLEAR_ACC");
                tests_passed = tests_passed + 1;
            end

            @(negedge clk);
            clear_acc = 1'b0;
        end
    endtask

    // Verify that invalid input preserves accumulator.
    task automatic test_invalid_cycle;
        logic signed [34:0] previous_acc;
        begin
            @(negedge clk);

            previous_acc = acc_out;
            acc_in       = acc_out;
            valid_in     = 1'b0;
            clear_acc    = 1'b0;

            @(posedge clk);
            #1;

            if (acc_out !== previous_acc || valid_out !== 1'b0) begin
                $display("[FAIL] INVALID_CYCLE");
                tests_failed = tests_failed + 1;
            end
            else begin
                $display("[PASS] INVALID_CYCLE");
                tests_passed = tests_passed + 1;
            end
        end
    endtask

    initial begin
        $display("");
        $display("======================================");
        $display(" AINeuronX N200 - INT16 MAC TESTBENCH");
        $display("======================================");
        $display("");

        rst_n       = 1'b0;
        clear_acc   = 1'b0;
        valid_in    = 1'b0;
        a           = '0;
        b           = '0;
        acc_in      = '0;
        expected    = 64'sd0;
        tests_passed = 0;
        tests_failed = 0;

        // Reset
        repeat (2) @(posedge clk);
        #1;

        if (acc_out !== 35'sd0 || valid_out !== 1'b0) begin
            $display("[FAIL] RESET");
            tests_failed = tests_failed + 1;
        end
        else begin
            $display("[PASS] RESET");
            tests_passed = tests_passed + 1;
        end

        @(negedge clk);
        rst_n = 1'b1;

        // Basic arithmetic
        apply_mac(16'sd10, 16'sd20, "POSITIVE x POSITIVE");
        apply_mac(-16'sd10, 16'sd20, "NEGATIVE x POSITIVE");
        apply_mac(-16'sd10, -16'sd20, "NEGATIVE x NEGATIVE");
        apply_mac(16'sd7, -16'sd9, "POSITIVE x NEGATIVE");

        test_invalid_cycle();

        // Reset accumulator between test groups.
        clear_accumulator();

        // INT16 extreme values.
        apply_mac(-16'sd32768, -16'sd32768,
                  "INT16 MIN x INT16 MIN");

        clear_accumulator();

        apply_mac(16'sd32767, 16'sd32767,
                  "INT16 MAX x INT16 MAX");

        apply_mac(-16'sd32768, 16'sd32767,
                  "INT16 MIN x INT16 MAX");

        clear_accumulator();

        // Eight maximum positive products.
        apply_mac(-16'sd32768, -16'sd32768, "MAX PRODUCT 1/8");
        apply_mac(-16'sd32768, -16'sd32768, "MAX PRODUCT 2/8");
        apply_mac(-16'sd32768, -16'sd32768, "MAX PRODUCT 3/8");
        apply_mac(-16'sd32768, -16'sd32768, "MAX PRODUCT 4/8");
        apply_mac(-16'sd32768, -16'sd32768, "MAX PRODUCT 5/8");
        apply_mac(-16'sd32768, -16'sd32768, "MAX PRODUCT 6/8");
        apply_mac(-16'sd32768, -16'sd32768, "MAX PRODUCT 7/8");
        apply_mac(-16'sd32768, -16'sd32768, "MAX PRODUCT 8/8");

        // Final summary.
        $display("");
        $display("======================================");
        $display(" TEST SUMMARY");
        $display("======================================");
        $display("Passed: %0d", tests_passed);
        $display("Failed: %0d", tests_failed);
        $display("");

        if (tests_failed == 0) begin
            $display("RESULT: ALL TESTS PASSED");
            $finish;
        end
        else begin
            $fatal(1, "INT16 MAC TESTBENCH FAILED");
        end
    end

    // Simulation timeout protection.
    initial begin
        #100000;
        $fatal(1, "TESTBENCH TIMEOUT");
    end

endmodule
